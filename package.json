{
  "name": "papliba",
  "version": "0.1.0",
  "description": "Papliba local-first workflow builder.",
  "private": true,
  "scripts": {
    "validate": "npm run validate:diagram && npm run build:web",
    "validate:diagram": "xmllint --noout docs/diagrams/papliba-architecture.drawio",
    "build:web": "npm --prefix src/Papliba.Web run build",
    "start:web": "npm --prefix src/Papliba.Web run dev -- --host 127.0.0.1 --port 5173",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "keywords": [
    "workflow",
    "automation",
    "local-first"
  ],
  "author": "Sunny Bharne",
  "license": "Apache-2.0",
  "type": "commonjs",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7"
  }
}
